{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genshin Navigator diagnostic bundle v4",
  "type": "object",
  "required": ["format_version", "privacy", "trigger", "frames"],
  "properties": {
    "format_version": {"const": 4},
    "privacy": {"type": "string"},
    "trigger": {"type": "string"},
    "trigger_frame_index": {"type": "integer", "minimum": 0},
    "environment": {"type": "object"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["image", "timestamp", "localization", "tracker"]
      }
    }
  }
}
